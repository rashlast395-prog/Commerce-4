# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Firebase Admin SDK (service account - keep this file out of git)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=

# Payments (leave blank until you have real credentials — backend will run
# in "mock payment" mode and log a warning if these are empty)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=info
